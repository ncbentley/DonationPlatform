# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=donor_network_table
METADATA_TABLE_NAME=event_metadata

# Web3 Configuration
WEB3_PROVIDER_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
WEB3_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/your-api-key
CONTRACT_ADDRESS=your_contract_address

# Event Processing Configuration
START_BLOCK=0  # The block number to start processing from
BLOCK_CHUNK_SIZE=1000  # Initial chunk size, will auto-adjust if needed 